# ============================================================================
#  ARPINT — variáveis de ambiente (Vercel: Settings > Environment Variables)
#  Tudo aqui é OPCIONAL no modo demo. Sem nada configurado a loja funciona
#  inteira com frete e pagamento SIMULADOS.
# ============================================================================

# demo (padrão)  = frete/pagamento simulados, faixa "MODO DEMONSTRAÇÃO" no topo
# producao       = só vende com provedores reais; se faltar algo, o checkout é bloqueado (falha fechado)
MODO=demo

SITE_URL=https://arpint.vercel.app        # sem barra no final; precisa ser https em produção
SEGREDO_APP=                              # mínimo 24 caracteres aleatórios (assina o link do pedido). Gere: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SAUDE_KEY=                                # senha para ver /api/saude?key=... (mostra o que falta configurar, sem segredos)

# ---------- Frete: demo | superfrete ----------
FRETE_PROVIDER=demo
SUPERFRETE_TOKEN=                         # superfrete.com > Integrações > Desenvolvedores
SUPERFRETE_SANDBOX=0                      # 1 = ambiente de testes da SuperFrete
SUPERFRETE_CONTATO=contato@arpint.com.br  # e-mail exigido no User-Agent da API
ORIGEM_CEP=                               # CEP de onde o pedido sai (ou "cepOrigem" em data/loja.json)
FRETE_CAIXA_PADRAO=30x20x15               # cm (comprimento x largura x altura) para produto sem medidas
FRETE_PESO_PADRAO_G=500                   # g, para produto sem peso

# ---------- Pagamento: demo | mercadopago ----------
PAGAMENTO_PROVIDER=demo
MERCADOPAGO_ACCESS_TOKEN=                 # TEST-... para testar, APP_USR-... para vender
MERCADOPAGO_WEBHOOK_SECRET=               # chave secreta do webhook (painel do Mercado Pago)
MERCADOPAGO_METODOS=credit_card,pix       # credit_card, debit_card, pix, boleto, saldo
MERCADOPAGO_PARCELAS=12

# ---------- Pedidos e estoque: memoria | upstash ----------
# Em produção use Upstash (grátis, Vercel > Storage > Upstash Redis). "memoria" some entre execuções.
STORE_PROVIDER=memoria
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Aviso de pedido pago: console | telegram ----------
NOTIFICAR_PROVIDER=console
TELEGRAM_BOT_TOKEN=                       # crie o bot com @BotFather
TELEGRAM_CHAT_ID=                         # seu chat (ou grupo) com o bot

# ---------- Catálogo ----------
# Opcional: em vez de data/produtos.csv, usar uma planilha do Google publicada como CSV
# (Arquivo > Compartilhar > Publicar na Web > CSV). O build puxa a planilha a cada deploy.
CATALOGO_CSV_URL=
